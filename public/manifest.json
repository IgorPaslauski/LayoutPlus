{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "short_name": "Layout+",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {"default": "Ctrl+Shift+9"},
      "description": "__MSG_cmdToggle__"
    },
    "cycle-preset": {
      "suggested_key": {"default": "Ctrl+Shift+8"},
      "description": "__MSG_cmdCycle__"
    },
    "toggle-presentation": {
      "suggested_key": {"default": "Ctrl+Shift+7"},
      "description": "__MSG_cmdPresentation__"
    }
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
